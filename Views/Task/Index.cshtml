@model MyMvcProject.ViewModels.TaskIndexViewModel

@{
    ViewData["Title"] = "Task Manager";
}

<div class="text-left mb-4">
    <h1 class="display-4">Task Manager</h1>
    <div class="text-end">
        <a href="@Url.Action("Create")" class="btn btn-primary">Create New Task</a>
    </div>
</div>

@if (!@Model.Tasks.Any())
{
    <div class="alert alert-info text-center text-light bg-secondary">
        <strong>No tasks available.</strong> Use the button above to create your first task!
    </div>
}
else
{
    <h2 class="mt-5 mb-3">Task Summary</h2>
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-info mb-3 shadow">
                <div class="card-header fw-bold">Total Tasks</div>
                <div class="card-body">
                    <h3 class="card-title">@Model.Summary.Total</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3 shadow">
                <div class="card-header fw-bold">Completed</div>
                <div class="card-body">
                    <h3 class="card-title">@Model.Summary.Completed</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning mb-3 shadow">
                <div class="card-header fw-bold">Remaining</div>
                <div class="card-body">
                    <h3 class="card-title">@Model.Summary.Remaining</h3>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-dark table-bordered table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Created At</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in @Model.Tasks)
            {
                <tr>
                    <td>@task.Title</td>
                    <td>@task.Description</td>
                    <td>@task.CreatedAt.ToShortDateString()</td>
                    <td>@(task.IsCompleted ? "Completed" : "Pending")</td>
                    <td>
                        @if (!task.IsCompleted)
                        {
                            <a href="@Url.Action("Complete", new { id = task.Id })" class="btn btn-success btn-sm">Complete</a>
                        }
                        <a href="@Url.Action("Delete", new { id = task.Id })" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
